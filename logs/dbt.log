  create  table "nf_da_onl_en_200726"."s_imrankhan"."mart_full_join__dbt_tmp"
  
  
    as
  
  (
    with ann as (
    select * from "nf_da_onl_en_200726"."s_imrankhan"."stg_annotation"
),
expr as (
    select * from "nf_da_onl_en_200726"."s_imrankhan"."mart_expression_summary"
),
fc as (
    select * from "nf_da_onl_en_200726"."s_imrankhan"."mart_foldchange_summary"
),
deg as (
    select gene_id from "nf_da_onl_en_200726"."s_imrankhan"."mart_deg_union"
)

select
    ann.gene_id,
    ann.gene_name,
    ann.gene_description,

    expr.*,
    fc.*,

    case when deg.gene_id is not null then 1 else 0 end as is_deg

from ann
left join expr using (gene_id)
left join fc using (gene_id)
left join deg using (gene_id)
  );
  
