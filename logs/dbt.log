    max(case when condition = 'l1l2_P' then expression end) as l1l2_P,
    max(case when condition = 'l1l2_nP' then expression end) as l1l2_nP

from "nf_da_onl_en_200726"."s_imrankhan"."stg_expression"
group by gene_id, gene_name
  );
  
