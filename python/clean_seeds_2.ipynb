import pandas as pd
import os

input_folder = "../data/processed"
output_folder = "../seeds"

# Create output folder if missing
os.makedirs(output_folder, exist_ok=True)

def clean_csv(file):
    print(f"Cleaning: {file}")

    df = pd.read_csv(os.path.join(input_folder, file), dtype=str)

    # Remove completely empty rows
    df = df.dropna(how="all")

    # Replace problematic values
    df = df.replace(["-", ".", ""], pd.NA)

    # Strip whitespace
    df = df.applymap(lambda x: x.strip() if isinstance(x, str) else x)

    # Ensure all rows have correct number of columns
    df = df[df.columns]  # re-align columns

    # Save cleaned file
    df.to_csv(os.path.join(output_folder, file.replace(".csv", "_raw.csv")), index=False)

    print(f"Saved cleaned file → {file.replace('.csv', '_raw.csv')}")


# List of your files
files = [
    "expression.csv",
    "foldchange_raw.csv",
    "annotation_raw.csv",
    "l112_downregulated.csv",
    "l112_upregulated.csv",
    "pdr2_downregulated.csv",
    "pdr2_upregulated.csv",
    "wt_downregulated.csv",
    "wt_upregulated.csv"
]

for f in files:
    clean_csv(f)

print("All files cleaned successfully.")
