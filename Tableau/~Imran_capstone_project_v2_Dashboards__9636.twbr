    <worksheet name='Volcano_PDR2_Up'>
      <table>
        <view>
          <datasources>
            <datasource caption='RNAseq_Main' name='federated.0pdpx5o06blt761fb1nej09pbzsz' />
          </datasources>
          <datasource-dependencies datasource='federated.0pdpx5o06blt761fb1nej09pbzsz'>
            <column caption='Regulation_PDR2_Clean' datatype='string' name='[Calculation_0728489203032065]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [pdr2_upregulated] = TRUE THEN &quot;Upregulated&quot;&#13;&#10;ELSEIF [pdr2_downregulated] = TRUE THEN &quot;Downregulated&quot;&#13;&#10;ELSE &quot;Neutral&quot;&#13;&#10;END' />
            </column>
            <column caption='Is_DEG_PDR2' datatype='string' name='[Calculation_0728489203519490]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [pdr2_upregulated] = TRUE OR [pdr2_downregulated] = TRUE&#13;&#10;THEN &quot;DEG&quot;&#13;&#10;ELSE &quot;Not DEG&quot;&#13;&#10;END' />
            </column>
            <column caption='NegLog10_Padj_pdr2' datatype='real' name='[Calculation_1687811387195402]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='-LOG([padj_pdr2_npvsp]) / LOG(10)' />
            </column>
            <column caption='Condition' datatype='string' name='[condition]' role='dimension' type='nominal' />
            <column caption='Expression Value' datatype='real' name='[expression_value]' role='measure' type='quantitative' />
            <column caption='Fc Pdr2 Npvsp' datatype='real' name='[fc_pdr2_npvsp]' role='measure' type='quantitative' />
            <column caption='Gene Name' datatype='string' name='[gene_name]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_0728489203032065]' derivation='None' name='[none:Calculation_0728489203032065:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_0728489203519490]' derivation='None' name='[none:Calculation_0728489203519490:nk]' pivot='key' type='nominal' />
            <column-instance column='[condition]' derivation='None' name='[none:condition:nk]' pivot='key' type='nominal' />
            <column-instance column='[gene_name]' derivation='None' name='[none:gene_name:nk]' pivot='key' type='nominal' />
