            <column caption='Rank_Sensitivity' datatype='integer' name='[Calculation_0728489242406919]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='INDEX()'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='MutantSensitivityScore' datatype='real' name='[Calculation_1491000218648582]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[fc_l1l2_npvsp] + [fc_pdr2_npvsp] - [fc_wt_npvsp]' />
            </column>
            <column caption='Is Deg' datatype='string' name='[Calculation_1491000224673800]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF &#13;&#10;    [l1l2_upregulated] OR&#13;&#10;    [l1l2_downregulated] OR&#13;&#10;    [pdr2_upregulated] OR&#13;&#10;    [pdr2_downregulated] OR&#13;&#10;    [wt_upregulated] OR&#13;&#10;    [wt_downregulated]&#13;&#10;THEN &quot;DEG&quot;&#13;&#10;ELSE &quot;Not DEG&quot;&#13;&#10;END' />
            </column>
            <column caption='Fc L1L2 Npvsp' datatype='real' name='[fc_l1l2_npvsp]' role='measure' type='quantitative' />
