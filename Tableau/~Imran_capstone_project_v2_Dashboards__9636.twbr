      <aliases enabled='yes' />
      <column caption='Tested in Both' datatype='boolean' name='[Calculation_0242507995549696]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='NOT ISNULL([padj_pdr2_npvsp])&#13;&#10;AND NOT ISNULL([padj_pdr2_npvsp])' />
      </column>
      <column caption='Both fold changes present' datatype='boolean' name='[Calculation_0242507998158849]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='NOT ISNULL([fc_wt_npvsp])&#13;&#10;AND NOT ISNULL([fc_pdr2_npvsp])' />
      </column>
      <column caption='WT vs PDR2 Direction' datatype='string' name='[Calculation_0242507998998530]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [fc_wt_npvsp] &gt; 0 AND [fc_pdr2_npvsp] &gt; 0 THEN&#13;&#10;    &quot;Positive in both&quot;&#13;&#10;ELSEIF [fc_wt_npvsp] &lt; 0 AND [fc_pdr2_npvsp] &lt; 0 THEN&#13;&#10;    &quot;Negative in both&quot;&#13;&#10;ELSEIF [fc_wt_npvsp] = 0 OR [fc_pdr2_npvsp] = 0 THEN&#13;&#10;    &quot;Zero on at least one axis&quot;&#13;&#10;ELSE&#13;&#10;    &quot;Opposite directions&quot;&#13;&#10;END' />
      </column>
      <column caption='Annotated' datatype='string' name='[Calculation_0427775216795648]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF NOT ISNULL([tf_family])&#13;&#10;OR NOT ISNULL([kegg_pathway_name])&#13;&#10;THEN &quot;Annotated&quot;&#13;&#10;ELSE &quot;Unannotated&quot;&#13;&#10;END' />
      </column>
      <column caption='Strong Candidate' datatype='string' name='[Calculation_0427775253155841]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ABS([fc_pdr2_npvsp]) &gt; 2&#13;&#10;OR ABS([fc_wt_npvsp]) &gt; 2&#13;&#10;THEN &quot;Yes&quot;&#13;&#10;ELSE &quot;No&quot;&#13;&#10;END' />
      </column>
      <column caption='ScaledValue' datatype='real' name='[Calculation_0462132919656452]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='( SUM([expression_value]) - WINDOW_AVG( SUM([expression_value]) ) )&#13;&#10;/&#13;&#10;WINDOW_STDEV( SUM([expression_value]) )'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='ExprDiff_Parameter_LOD' datatype='real' name='[Calculation_0728489197060096]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [gene_name] :&#13;&#10;    SUM(&#13;&#10;        IF [condition] = [Parameters].[Parameter 1491000216891392] THEN [expression_value] END&#13;&#10;    )&#13;&#10;    -&#13;&#10;    SUM(&#13;&#10;        IF [condition] = [Parameters].[Parameter 1491000217190401] THEN [expression_value] END&#13;&#10;    )&#13;&#10;}' />
      </column>
      <column caption='Regulation_PDR2_Clean' datatype='string' name='[Calculation_0728489203032065]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [pdr2_upregulated] = TRUE THEN &quot;Upregulated&quot;&#13;&#10;ELSEIF [pdr2_downregulated] = TRUE THEN &quot;Downregulated&quot;&#13;&#10;ELSE &quot;Neutral&quot;&#13;&#10;END' />
      </column>
      <column caption='Is_DEG_PDR2' datatype='string' name='[Calculation_0728489203519490]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [pdr2_upregulated] = TRUE OR [pdr2_downregulated] = TRUE&#13;&#10;THEN &quot;DEG&quot;&#13;&#10;ELSE &quot;Not DEG&quot;&#13;&#10;END' />
      </column>
      <column caption='Rank_Sensitivity' datatype='integer' name='[Calculation_0728489242406919]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INDEX()'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='WT_Expr' datatype='real' name='[Calculation_1178739903082496]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF CONTAINS([condition], &quot;WT&quot;) THEN [expression_value] END' />
      </column>
      <column caption='PDR2_Expr' datatype='real' name='[Calculation_1178739903913985]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF CONTAINS([condition], &quot;pdr2&quot;) THEN [expression_value] END' />
      </column>
      <column caption='FC_WT_vs_PDR2' datatype='real' name='[Calculation_1178739903991810]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN(SUM([Calculation_1178739903082496])) - ZN(SUM([Calculation_1178739903913985]))' />
      </column>
      <column caption='FC_Abs' datatype='real' name='[Calculation_1178739912638472]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ABS([Calculation_1178739903991810])' />
      </column>
      <column caption='WT_P_vs_WT_nP' datatype='real' name='[Calculation_1178739917783049]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [condition] = &quot;WT_P&quot; THEN [expression_value]&#13;&#10;ELSEIF [condition] = &quot;WT_nP&quot; THEN -[expression_value]&#13;&#10;END' />
      </column>
      <column caption='pdr2_P_vs_pdr2_nP' datatype='real' name='[Calculation_1178739919196170]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [condition] = &quot;pdr2_P&quot; THEN [expression_value]&#13;&#10;ELSEIF [condition] = &quot;pdr2_nP&quot; THEN -[expression_value]&#13;&#10;END' />
      </column>
      <column caption='WT_nP_vs_pdr2_nP' datatype='real' name='[Calculation_1178739919319051]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [condition] = &quot;WT_nP&quot; THEN [expression_value]&#13;&#10;ELSEIF [condition] = &quot;pdr2_nP&quot; THEN -[expression_value]&#13;&#10;END' />
      </column>
      <column caption='Comparison' datatype='string' name='[Calculation_1178739919454220]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [condition] IN (&quot;WT_P&quot;,&quot;WT_nP&quot;) THEN &quot;WT_P vs WT_nP&quot;&#13;&#10;ELSEIF [condition] IN (&quot;pdr2_P&quot;,&quot;pdr2_nP&quot;) THEN &quot;pdr2_P vs pdr2_nP&quot;&#13;&#10;ELSEIF [condition] IN (&quot;WT_nP&quot;,&quot;pdr2_nP&quot;) THEN &quot;WT_nP vs pdr2_nP&quot;&#13;&#10;END' />
      </column>
      <column caption='FC_Matrix' datatype='real' name='[Calculation_1178739921735694]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Calculation_1178739919454220]&#13;&#10;    WHEN &quot;WT_P vs WT_nP&quot; THEN [Calculation_1178739917783049]&#13;&#10;    WHEN &quot;pdr2_P vs pdr2_nP&quot; THEN [Calculation_1178739919196170]&#13;&#10;    WHEN &quot;WT_nP vs pdr2_nP&quot; THEN [Calculation_1178739919319051]&#13;&#10;END' />
      </column>
      <column caption='Is Up' datatype='integer' name='[Calculation_1178739953156115]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_1178739921735694] &gt; 0 THEN 1&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Is Down' datatype='integer' name='[Calculation_1178739953893396]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_1178739921735694] &lt; 0 THEN 1&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='DEG_Stars_Directional' datatype='string' name='[Calculation_1178739954257942]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1178739953156115] = 1 THEN &quot;↑*&quot;&#13;&#10;ELSEIF [Calculation_1178739953893396] = 1 THEN &quot;↓*&quot;&#13;&#10;ELSE &quot;&quot;&#13;&#10;END' />
      </column>
      <column caption='GeneSet' datatype='string' name='[Calculation_1178739959279640]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF NOT ISNULL([kegg_pathway_name]) AND [kegg_pathway_name] &lt;&gt; &quot;&quot; AND [kegg_pathway_name] &lt;&gt; &quot;-&quot; THEN&#13;&#10;    [kegg_pathway_name]&#13;&#10;ELSEIF NOT ISNULL([tf_family]) AND [tf_family] &lt;&gt; &quot;&quot; AND [tf_family] &lt;&gt; &quot;-&quot; THEN&#13;&#10;    [tf_family]&#13;&#10;ELSEIF NOT ISNULL([gene_biotype]) AND [gene_biotype] &lt;&gt; &quot;&quot; AND [gene_biotype] &lt;&gt; &quot;-&quot; THEN&#13;&#10;    [gene_biotype]&#13;&#10;ELSE&#13;&#10;    &quot;Other&quot;&#13;&#10;END' />
      </column>
      <column caption='CollectionType' datatype='string' name='[Calculation_1178739959377945]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [tf_family] = &quot;&quot; OR [tf_family] = &quot;-&quot; OR ISNULL([tf_family]) THEN&#13;&#10;    IF NOT ISNULL([kegg_pathway_name]) AND [kegg_pathway_name] &lt;&gt; &quot;&quot; AND [kegg_pathway_name] &lt;&gt; &quot;-&quot; THEN&#13;&#10;        &quot;KEGG Pathway&quot;&#13;&#10;    ELSEIF NOT ISNULL([gene_biotype]) AND [gene_biotype] &lt;&gt; &quot;&quot; AND [gene_biotype] &lt;&gt; &quot;-&quot; THEN&#13;&#10;        &quot;Biotype&quot;&#13;&#10;    ELSE&#13;&#10;        &quot;Other&quot;&#13;&#10;    END&#13;&#10;ELSE&#13;&#10;    &quot;TF Family&quot;&#13;&#10;END' />
      </column>
      <column caption='MutantSensitivityScore' datatype='real' name='[Calculation_1491000218648582]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[fc_l1l2_npvsp] + [fc_pdr2_npvsp] - [fc_wt_npvsp]' />
      </column>
      <column caption='Is Deg' datatype='string' name='[Calculation_1491000224673800]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF &#13;&#10;    [l1l2_upregulated] OR&#13;&#10;    [l1l2_downregulated] OR&#13;&#10;    [pdr2_upregulated] OR&#13;&#10;    [pdr2_downregulated] OR&#13;&#10;    [wt_upregulated 1] OR&#13;&#10;    [wt_downregulated]&#13;&#10;THEN &quot;DEG&quot;&#13;&#10;ELSE &quot;Not DEG&quot;&#13;&#10;END' />
      </column>
      <column caption='NegLog10_Padj_pdr2' datatype='real' name='[Calculation_1687811387195402]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='-LOG([padj_pdr2_npvsp]) / LOG(10)' />
      </column>
      <column caption='WT Response Class' datatype='string' name='[Calculation_1868685644599296]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([padj_wt_npvsp]) THEN&#13;&#10;    &quot;Not tested&quot;&#13;&#10;ELSEIF [padj_wt_npvsp] &gt;= 0.05 THEN&#13;&#10;    &quot;Not significant&quot;&#13;&#10;ELSEIF ISNULL([fc_wt_npvsp]) THEN&#13;&#10;    &quot;FDR significant, fold change missing&quot;&#13;&#10;ELSEIF [fc_wt_npvsp] &gt;= 1 THEN&#13;&#10;    &quot;Up in nP&quot;&#13;&#10;ELSEIF [fc_wt_npvsp] &lt;= -1 THEN&#13;&#10;    &quot;Down in nP&quot;&#13;&#10;ELSE&#13;&#10;    &quot;FDR significant, smaller effect&quot;&#13;&#10;END' />
      </column>
      <column caption='PDR2 Response Class' datatype='string' name='[Calculation_1868685646180353]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([padj_pdr2_npvsp]) THEN&#13;&#10;    &quot;Not tested&quot;&#13;&#10;ELSEIF [padj_pdr2_npvsp] &gt;= 0.05 THEN&#13;&#10;    &quot;Not significant&quot;&#13;&#10;ELSEIF ISNULL([fc_pdr2_npvsp]) THEN&#13;&#10;    &quot;FDR significant, fold change missing&quot;&#13;&#10;ELSEIF [fc_pdr2_npvsp] &gt;= 1 THEN&#13;&#10;    &quot;Up in nP&quot;&#13;&#10;ELSEIF [fc_pdr2_npvsp] &lt;= -1 THEN&#13;&#10;    &quot;Down in nP&quot;&#13;&#10;ELSE&#13;&#10;    &quot;FDR significant, smaller effect&quot;&#13;&#10;END' />
      </column>
      <column caption='WT −log10 FDR' datatype='real' name='[Calculation_2100133204619265]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL([padj_wt_npvsp]) OR [padj_wt_npvsp] &lt;= 0 THEN&#13;&#10;    NULL&#13;&#10;ELSE&#13;&#10;    -LOG([padj_wt_npvsp], 10)&#13;&#10;END' />
      </column>
      <column caption='PDR2 −log10 FDR' datatype='real' name='[Calculation_2100133212393474]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL([padj_pdr2_npvsp]) OR [padj_pdr2_npvsp] &lt;= 0 THEN&#13;&#10;    NULL&#13;&#10;ELSE&#13;&#10;    -LOG([padj_pdr2_npvsp]) / LOG(10)&#13;&#10;END' />
      </column>
      <column caption='WT Significant TF Genes' datatype='integer' name='[Calculation_2100133224620035]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [Calculation_1868685644599296] = &quot;Up in nP&quot;&#13;&#10;    OR [Calculation_1868685644599296] = &quot;Down in nP&quot;&#13;&#10;    OR [Calculation_1868685644599296] = &quot;FDR significant, smaller effect&quot;&#13;&#10;    THEN [gene_id]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='PDR2 Significant TF Genes' datatype='integer' name='[Calculation_2100133224751108]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [Calculation_1868685646180353] = &quot;Up in nP&quot;&#13;&#10;    OR [Calculation_1868685646180353] = &quot;Down in nP&quot;&#13;&#10;    OR [Calculation_1868685646180353] = &quot;FDR significant, smaller effect&quot;&#13;&#10;    THEN [gene_id]&#13;&#10;    END&#13;&#10;)' />
