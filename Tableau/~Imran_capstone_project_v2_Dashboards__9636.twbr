        <zone forceUpdate='true' h='12111' id='15' type-v2='text' w='75486' x='1806' y='-1222'>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontsize='14'>How Does PDR2 Shape the </run>
            <run bold='true' fontcolor='#000000' fontsize='14' italic='true'>Arabidopsis</run>
            <run bold='true' fontcolor='#000000' fontsize='14'> Response to Phosphate Starvation?</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontsize='11'>We compare gene activity in wild type and pdr2 plants under phosphate-sufficient and phosphate-starved conditions to identify shared and genotype-specific responses.</run>
          </formatted-text>
          <zone-style>
            <format attr='border-color' value='#444444' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='background-color' value='#fbf7fb' />
          </zone-style>
        </zone>
        <zone h='39667' id='16' is-centered='0' is-scaled='1' param='Image/ChatGPT Image Nov 13, 2026, 12_08_37 PM.png' type-v2='bitmap' w='42153' x='2500' y='10333' />
        <zone h='41667' id='19' is-centered='0' is-scaled='1' param='Image/ChatGPT Image Nov 13, 2026, 01_39_44 PM.png' type-v2='bitmap' w='42847' x='52431' y='9667' />
        <zone h='50444' id='20' is-centered='0' is-scaled='1' param='Image/KPIs.png' type-v2='bitmap' w='60000' x='3472' y='51222' />
        <zone forceUpdate='true' h='22222' id='23' type-v2='text' w='18472' x='64097' y='75556'>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='12'>Key</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>• </run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Bold'>WT: Normal </run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>• </run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Bold'>PDR2/pdr2: PDR2 inactive</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>• </run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Bold'>+Pi : Phosphate available</run>
            <run>Æ&#10;&#10;</run>
            <run fontcolor='#000000' fontname='Benton Sans Book'>• </run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Bold'>−Pi: Phosphate limited</run>
          </formatted-text>
          <zone-style>
            <format attr='border-color' value='#444444' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='background-color' value='#f5f5f5' />
          </zone-style>
        </zone>
        <zone forceUpdate='true' h='22222' id='24' type-v2='text' w='33889' x='64236' y='54667'>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Tableau Medium' fontsize='12'>Key Takeaway</run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#000000' fontname='Tableau Medium'>Most of the genes showed the same response direction</run>
            <run>Æ&#10;</run>
            <run fontcolor='#000000' fontname='Tableau Medium'>That’s 11,815 of the 20,800 genes with fold-change data in both genotypes. This compares direction across all genes with data; it is not the percentage of statistically significant genes</run>
          </formatted-text>
        </zone>
        <zone forceUpdate='true' h='7667' id='51' is-centered='0' is-scaled='1' param='Image/chemical_1739496.png' type-v2='bitmap' w='5764' x='92153' y='1667' />
      </zones>
