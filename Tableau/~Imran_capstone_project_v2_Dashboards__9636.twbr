    <worksheet name='WT vs PDR2 Direction Agreement'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontname='Tableau Book' fontsize='12'>Among genes with fold-change data in both genotypes, how many change in the same or opposite direction?</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='RNAseq mart v2 WT PDR2' name='federated.0rf4sww0emvk6d15zftie1v0sa6l' />
          </datasources>
          <datasource-dependencies datasource='federated.0rf4sww0emvk6d15zftie1v0sa6l'>
            <column caption='Tested in Both' datatype='boolean' name='[Calculation_0242507995549696]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='NOT ISNULL([padj_pdr2_npvsp])&#13;&#10;AND NOT ISNULL([padj_pdr2_npvsp])' />
            </column>
            <column caption='Both fold changes present' datatype='boolean' name='[Calculation_0242507998158849]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='NOT ISNULL([fc_wt_npvsp])&#13;&#10;AND NOT ISNULL([fc_pdr2_npvsp])' />
            </column>
            <column caption='WT vs PDR2 Direction' datatype='string' name='[Calculation_0242507998998530]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [fc_wt_npvsp] &gt; 0 AND [fc_pdr2_npvsp] &gt; 0 THEN&#13;&#10;    &quot;Positive in both&quot;&#13;&#10;ELSEIF [fc_wt_npvsp] &lt; 0 AND [fc_pdr2_npvsp] &lt; 0 THEN&#13;&#10;    &quot;Negative in both&quot;&#13;&#10;ELSEIF [fc_wt_npvsp] = 0 OR [fc_pdr2_npvsp] = 0 THEN&#13;&#10;    &quot;Zero on at least one axis&quot;&#13;&#10;ELSE&#13;&#10;    &quot;Opposite directions&quot;&#13;&#10;END' />
            </column>
            <column-instance column='[gene_id]' derivation='CountD' name='[ctd:gene_id:qk]' pivot='key' type='quantitative' />
            <column caption='Fc Pdr2 Npvsp' datatype='real' name='[fc_pdr2_npvsp]' role='measure' type='quantitative' />
            <column caption='Fc Wt Npvsp' datatype='real' name='[fc_wt_npvsp]' role='measure' type='quantitative' />
            <column caption='Gene Id' datatype='string' name='[gene_id]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_0242507995549696]' derivation='None' name='[none:Calculation_0242507995549696:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_0242507998158849]' derivation='None' name='[none:Calculation_0242507998158849:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_0242507998998530]' derivation='None' name='[none:Calculation_0242507998998530:nk]' pivot='key' type='nominal' />
            <column caption='Padj Pdr2 Npvsp' datatype='real' name='[padj_pdr2_npvsp]' role='measure' type='quantitative' />
          </datasource-dependencies>
