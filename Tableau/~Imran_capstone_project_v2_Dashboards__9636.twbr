    <worksheet name='Sankey Diagram'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#000000' fontname='Tableau Medium' fontsize='12'>Which transcription factor families are connected to which biological pathways through specific genes?</run>
            <run fontalignment='1'>Æ&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='RNAseq_Main' name='federated.0pdpx5o06blt761fb1nej09pbzsz' />
          </datasources>
          <datasource-dependencies datasource='federated.0pdpx5o06blt761fb1nej09pbzsz'>
            <column caption='Expression Value' datatype='real' name='[expression_value]' role='measure' type='quantitative' />
            <column caption='Gene Id' datatype='string' name='[gene_id]' role='dimension' type='nominal' />
            <column caption='Kegg Pathway Name' datatype='string' name='[kegg_pathway_name]' role='dimension' type='nominal' />
            <column-instance column='[gene_id]' derivation='None' name='[none:gene_id:nk]' pivot='key' type='nominal' />
            <column-instance column='[kegg_pathway_name]' derivation='None' name='[none:kegg_pathway_name:nk]' pivot='key' type='nominal' />
            <column-instance column='[tf_family]' derivation='None' name='[none:tf_family:nk]' pivot='key' type='nominal' />
            <column caption='Tf Family' datatype='string' name='[tf_family]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0pdpx5o06blt761fb1nej09pbzsz].[Exclusions (Gene Id,Kegg Pathway Name,Tf Family)]'>
            <groupfilter function='except' user:ui-domain='database' user:ui-enumeration='exclusive' user:ui-marker='enumerate'>
              <groupfilter function='crossjoin'>
                <groupfilter function='level-members' level='[none:gene_id:nk]' />
                <groupfilter function='level-members' level='[none:kegg_pathway_name:nk]' />
                <groupfilter function='level-members' level='[none:tf_family:nk]' />
              </groupfilter>
              <groupfilter function='reorder-dimensionality'>
                <groupfilter function='crossjoin'>
                  <groupfilter function='member' level='[none:tf_family:nk]' member='&quot;-&quot;' />
                  <groupfilter function='union'>
                    <groupfilter function='crossjoin'>
                      <groupfilter function='member' level='[none:kegg_pathway_name:nk]' member='&quot;.&quot;' />
                      <groupfilter function='union'>
                        <groupfilter function='member' level='[none:gene_id:nk]' member='&quot;AT1G76010&quot;' />
                        <groupfilter function='member' level='[none:gene_id:nk]' member='&quot;AT1G76180&quot;' />
                        <groupfilter function='member' level='[none:gene_id:nk]' member='&quot;AT1G76200&quot;' />
                        <groupfilter function='member' level='[none:gene_id:nk]' member='&quot;AT1G78040&quot;' />
                        <groupfilter function='member' level='[none:gene_id:nk]' member='&quot;AT1G78300&quot;' />
                        <groupfilter function='member' level='[none:gene_id:nk]' member='&quot;AT4G40090&quot;' />
                        <groupfilter function='member' level='[none:gene_id:nk]' member='&quot;AT5G67500&quot;' />
                      </groupfilter>
