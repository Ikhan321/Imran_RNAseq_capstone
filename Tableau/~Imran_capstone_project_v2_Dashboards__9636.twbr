      <column caption='FDR Heat Score' datatype='real' name='[Calculation_1800792250966020]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL([fdr_bh]) THEN NULL&#13;&#10;ELSEIF [fdr_bh] &gt;= 0.05 THEN 0&#13;&#10;ELSEIF [fdr_bh] &lt;= 0 THEN 12&#13;&#10;ELSE -LOG([fdr_bh], 10)&#13;&#10;END' />
      </column>
      <column caption='−log10 FDR' datatype='real' name='[Calculation_2100133187432448]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [fdr_bh] &gt; 0 THEN&#13;&#10;    -LN([fdr_bh]) / LN(10)&#13;&#10;END' />
      </column>
