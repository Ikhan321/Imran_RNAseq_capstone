              <calculation class='tableau' formula='IF ISNULL([padj_wt_npvsp]) THEN&#13;&#10;    &quot;Not tested&quot;&#13;&#10;ELSEIF [padj_wt_npvsp] &gt;= 0.05 THEN&#13;&#10;    &quot;Not significant&quot;&#13;&#10;ELSEIF ISNULL([fc_wt_npvsp]) THEN&#13;&#10;    &quot;FDR significant, fold change missing&quot;&#13;&#10;ELSEIF [fc_wt_npvsp] &gt;= 1 THEN&#13;&#10;    &quot;Up in nP&quot;&#13;&#10;ELSEIF [fc_wt_npvsp] &lt;= -1 THEN&#13;&#10;    &quot;Down in nP&quot;&#13;&#10;ELSE&#13;&#10;    &quot;FDR significant, smaller effect&quot;&#13;&#10;END' />
