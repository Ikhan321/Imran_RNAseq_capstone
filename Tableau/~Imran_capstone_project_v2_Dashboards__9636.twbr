    <worksheet name='Ranking Score'>
      <table>
        <view>
          <datasources>
            <datasource caption='RNAseq_Main' name='federated.0pdpx5o06blt761fb1nej09pbzsz' />
          </datasources>
          <datasource-dependencies datasource='federated.0pdpx5o06blt761fb1nej09pbzsz'>
            <column caption='WT_Expr' datatype='real' name='[Calculation_1178739903082496]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF CONTAINS([condition], &quot;WT&quot;) THEN [expression_value] END' />
            </column>
            <column caption='PDR2_Expr' datatype='real' name='[Calculation_1178739903913985]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF CONTAINS([condition], &quot;pdr2&quot;) THEN [expression_value] END' />
            </column>
            <column caption='FC_WT_vs_PDR2' datatype='real' name='[Calculation_1178739903991810]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(SUM([Calculation_1178739903082496])) - ZN(SUM([Calculation_1178739903913985]))' />
            </column>
            <column caption='FC_Abs' datatype='real' name='[Calculation_1178739912638472]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ABS([Calculation_1178739903991810])' />
            </column>
            <column caption='Condition' datatype='string' name='[condition]' role='dimension' type='nominal' />
            <column caption='Expression Value' datatype='real' name='[expression_value]' role='measure' type='quantitative' />
            <column caption='Gene Id' datatype='string' name='[gene_id]' role='dimension' type='nominal' />
            <column-instance column='[gene_id]' derivation='None' name='[none:gene_id:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1178739903991810]' derivation='User' name='[usr:Calculation_1178739903991810:qk]' pivot='key' type='quantitative' />
